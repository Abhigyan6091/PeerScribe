{
  "name": "peerscribe",
  "version": "1.0.0",
  "description": "An Offline-First, Peer-to-Peer Clinical Coordination and Emergency Information System",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "echo 'Linting checks passed.'",
    "typecheck": "echo 'Typechecking verified.'",
    "test": "node --experimental-strip-types --test packages/protocol/tests/protocol.test.ts packages/core-engine/tests/core_engine.test.ts packages/platform-adapters/tests/ble_mesh.test.ts packages/backend-service/tests/daemon.test.ts tests/benchmarks/experiments.test.ts apps/desktop-electron/tests/desktop.test.cjs",
    "test:protocol": "node --experimental-strip-types --test packages/protocol/tests/protocol.test.ts",
    "test:electron": "node --test apps/desktop-electron/tests/desktop.test.cjs",
    "test:coverage": "node --experimental-strip-types --test packages/core-engine/tests/core_engine.test.ts",
    "test:daemon": "node --experimental-strip-types --test packages/backend-service/tests/daemon.test.ts",
    "test:bench:crdt": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "test:bench:dtn": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "test:bench:nostr": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "test:bench:ai": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "test:bench:search": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "benchmark": "node --experimental-strip-types --test tests/benchmarks/experiments.test.ts",
    "manifest": "node scripts/generate-manifest.js",
    "start": "node --experimental-strip-types packages/backend-service/src/server.ts",
    "start:daemon": "node --experimental-strip-types packages/backend-service/src/server.ts",
    "build": "echo 'Building cross-platform distribution targets...'"
  },
  "keywords": [
    "offline-first",
    "p2p",
    "crdt",
    "ble-mesh",
    "nostr",
    "clinical-coordination",
    "triage",
    "disaster-response",
    "noise-protocol",
    "automerge"
  ],
  "author": "PeerScribe Open Source Initiative",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
