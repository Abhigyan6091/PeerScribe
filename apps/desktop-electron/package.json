{
  "name": "@peerscribe/desktop-electron",
  "version": "1.0.0",
  "description": "PeerScribe Windows Desktop Tactical Clinical Mesh Client",
  "author": "PeerScribe Open Source Initiative",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable zip",
    "test": "node --test tests/desktop.test.cjs"
  },
  "dependencies": {
    "@peerscribe/protocol": "*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.peerscribe.desktop",
    "productName": "PeerScribe Tactical Desktop",
    "electronVersion": "33.2.1",
    "copyright": "Copyright © 2026 PeerScribe Open Source Initiative",
    "publish": [
      {
        "provider": "github",
        "owner": "Abhigyan6091",
        "repo": "PeerScribe"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "PeerScribe-Windows-${channel}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PeerScribe Tactical Mesh",
      "differentialPackage": true
    }
  }
}
